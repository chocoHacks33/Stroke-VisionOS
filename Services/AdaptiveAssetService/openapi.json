{
  "openapi": "3.1.0",
  "info": {
    "title": "Stroke Vision Adaptive Asset Service",
    "version": "0.2.0",
    "description": "Local, non-diagnostic presentation adaptation for patient/family educational assets. This API does not accept biometrics or infer anxiety. The prototype authorizes developer preview only and always returns patient_display_authorized=false."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765",
      "description": "Loopback development server"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check service and catalog readiness",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/catalog": {
      "get": {
        "operationId": "listCatalogAssets",
        "summary": "List path-free public metadata for the local developer control panel",
        "description": "Returns stable manifest IDs and display metadata. It never returns catalog roots, manifest paths, or package paths.",
        "responses": {
          "200": {
            "description": "Public catalog metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/visual-adaptations": {
      "post": {
        "operationId": "createVisualAdaptation",
        "summary": "Create an immediate edit recipe or queue a clinician-gated procedural draft",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdaptationRequest"
              },
              "examples": {
                "selfReportedSimplified": {
                  "value": {
                    "asset_id": "artery_wall_cutaway_v2",
                    "audience": "patient",
                    "mode": "auto",
                    "adaptation_source": "self_report_preference",
                    "detail_preference": "simplified",
                    "motion_preference": "reduced"
                  }
                },
                "seededDemo": {
                  "value": {
                    "asset_id": "artery_wall_cutaway_v2",
                    "audience": "family",
                    "mode": "generate",
                    "adaptation_source": "simulated_demo",
                    "simulation_seed": 42,
                    "motion_preference": "static"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Runtime sidecar recipe completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditResponse"
                }
              }
            }
          },
          "202": {
            "description": "Local procedural draft accepted for asynchronous generation and clinical review",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "411": {
            "$ref": "#/components/responses/LengthRequired"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "413": {
            "$ref": "#/components/responses/RequestTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          }
        }
      }
    },
    "/v1/adaptations": {
      "post": {
        "deprecated": true,
        "operationId": "createVisualAdaptationAlias",
        "summary": "Compatibility alias for /v1/visual-adaptations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdaptationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Runtime sidecar recipe completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditResponse"
                }
              }
            }
          },
          "202": {
            "description": "Procedural draft accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "411": {
            "$ref": "#/components/responses/LengthRequired"
          },
          "413": {
            "$ref": "#/components/responses/RequestTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          }
        }
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "operationId": "getGenerationJob",
        "summary": "Poll an asynchronous procedural draft",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "description": "Current job state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationJob"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/artifacts/{job_id}/{filename}": {
      "get": {
        "operationId": "downloadReviewDraft",
        "summary": "Download a non-display-authorized draft for clinical review",
        "description": "Responses set X-Display-Authorized: false and X-Clinical-Review-Required: true.",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          },
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "scene.usda",
                "recipe.json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Review-only draft",
            "headers": {
              "X-Display-Authorized": {
                "schema": {
                  "type": "string",
                  "const": "false"
                }
              },
              "X-Clinical-Review-Required": {
                "schema": {
                  "type": "string",
                  "const": "true"
                }
              }
            },
            "content": {
              "model/vnd.usda": {
                "schema": {
                  "type": "string",
                  "contentMediaType": "model/vnd.usda"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewArtifactEnvelope"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "JobId": {
        "name": "job_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request, including rejected biometric or diagnostic fields",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Asset, job, artifact, or route not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "RequestTooLarge": {
        "description": "Request exceeds 16 KiB",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "LengthRequired": {
        "description": "Content-Length is required for POST requests",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "Content-Type is not application/json",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "AdaptationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "audience",
          "mode",
          "adaptation_source"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "description": "Exact manifest ID; it is never interpreted as a path."
          },
          "audience": {
            "type": "string",
            "enum": [
              "patient",
              "family"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "auto",
              "edit",
              "generate"
            ]
          },
          "adaptation_source": {
            "type": "string",
            "enum": [
              "simulated_demo",
              "self_report_preference",
              "clinician_override"
            ]
          },
          "detail_preference": {
            "type": "string",
            "enum": [
              "overview",
              "simplified",
              "standard",
              "clinical_detail"
            ]
          },
          "motion_preference": {
            "type": "string",
            "default": "system_default",
            "enum": [
              "system_default",
              "reduced",
              "static"
            ]
          },
          "simulation_seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807,
            "description": "Accepted only for simulated_demo; makes the demo choice reproducible."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "adaptation_source": {
                  "enum": [
                    "self_report_preference",
                    "clinician_override"
                  ]
                }
              },
              "required": [
                "adaptation_source"
              ]
            },
            "then": {
              "required": [
                "detail_preference"
              ],
              "not": {
                "required": [
                  "simulation_seed"
                ]
              }
            }
          }
        ]
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "service",
          "version",
          "catalog",
          "adaptation_mapping",
          "diagnostic_inference"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "service": {
            "const": "adaptive-asset-service"
          },
          "version": {
            "type": "string"
          },
          "catalog": {
            "type": "object",
            "required": [
              "assets",
              "manifests"
            ],
            "properties": {
              "assets": {
                "type": "integer",
                "minimum": 1
              },
              "manifests": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "adaptation_mapping": {
            "$ref": "#/components/schemas/AdaptationMappingSummary"
          },
          "diagnostic_inference": {
            "const": false
          }
        }
      },
      "AdaptationMappingSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "configured",
          "profiled_assets",
          "entity_mapped_assets"
        ],
        "properties": {
          "configured": { "type": "boolean" },
          "profiled_assets": { "type": "integer", "minimum": 0 },
          "entity_mapped_assets": { "type": "integer", "minimum": 0 }
        }
      },
      "CatalogResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "catalog",
          "assets"
        ],
        "properties": {
          "catalog": {
            "$ref": "#/components/schemas/CatalogSummary"
          },
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogAsset"
            }
          }
        }
      },
      "CatalogSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assets",
          "manifests"
        ],
        "properties": {
          "assets": {
            "type": "integer",
            "minimum": 1
          },
          "manifests": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "CatalogAsset": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "title",
          "module",
          "description",
          "clinical_review_status",
          "package_name",
          "package_bytes",
          "package_sha256",
          "package_integrity"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "clinical_review_status": {
            "type": "string"
          },
          "package_name": {
            "type": "string",
            "description": "Package basename only; no relative or absolute path is exposed."
          },
          "package_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "package_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "package_integrity": {
            "type": "string",
            "enum": [
              "verified_against_manifest",
              "partially_verified_against_manifest",
              "observed_without_manifest_digest"
            ]
          },
          "adaptation_profile": {
            "$ref": "#/components/schemas/CatalogProfileSummary"
          },
          "entity_mapping": {
            "$ref": "#/components/schemas/EntityMappingSummary"
          }
        }
      },
      "CatalogProfileSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "presentation_intensity",
          "content_categories",
          "graphic_content_tags",
          "role",
          "patient_display_authorized"
        ],
        "properties": {
          "presentation_intensity": {
            "enum": ["minimal", "low", "moderate", "high"]
          },
          "content_categories": {
            "type": "array",
            "items": { "type": "string" }
          },
          "graphic_content_tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "role": {
            "enum": ["standalone", "component", "aggregate", "orientation_candidate"]
          },
          "patient_display_authorized": { "const": false }
        }
      },
      "EntityMappingSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mapping_status",
          "selector_kind",
          "package_sha256",
          "model_entity_count",
          "animation_resource_count",
          "primary_semantic_group",
          "semantic_group_counts"
        ],
        "properties": {
          "mapping_status": { "const": "exact_revision_bound" },
          "selector_kind": { "const": "child_index_path" },
          "package_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "model_entity_count": { "type": "integer", "minimum": 1 },
          "animation_resource_count": { "type": "integer", "minimum": 0 },
          "primary_semantic_group": { "type": "string" },
          "semantic_group_counts": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "SourceAsset": {
        "type": "object",
        "required": [
          "asset_id",
          "title",
          "module",
          "description",
          "clinical_review_status",
          "package_name",
          "package_bytes",
          "package_sha256",
          "package_integrity"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "clinical_review_status": {
            "type": "string"
          },
          "package_name": {
            "type": "string"
          },
          "package_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "package_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "package_integrity": {
            "enum": [
              "verified_against_manifest",
              "partially_verified_against_manifest",
              "observed_without_manifest_digest"
            ]
          }
        }
      },
      "SourceAssetRevision": {
        "type": "object",
        "required": [
          "package_name",
          "package_bytes",
          "package_sha256",
          "package_integrity"
        ],
        "properties": {
          "package_name": {
            "type": "string"
          },
          "package_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "package_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "package_integrity": {
            "enum": [
              "verified_against_manifest",
              "partially_verified_against_manifest",
              "observed_without_manifest_digest"
            ]
          }
        }
      },
      "PresentationPreference": {
        "type": "object",
        "required": [
          "detail_preference",
          "motion_preference",
          "source",
          "simulated",
          "non_diagnostic",
          "notice",
          "biometric_inputs_used"
        ],
        "properties": {
          "detail_preference": {
            "enum": [
              "overview",
              "simplified",
              "standard",
              "clinical_detail"
            ]
          },
          "motion_preference": {
            "enum": [
              "system_default",
              "reduced",
              "static"
            ]
          },
          "source": {
            "type": "string"
          },
          "simulated": {
            "type": "boolean"
          },
          "non_diagnostic": {
            "const": true
          },
          "notice": {
            "type": "string"
          },
          "biometric_inputs_used": {
            "const": false
          }
        }
      },
      "Recipe": {
        "type": "object",
        "required": [
          "schema_version",
          "policy_version",
          "asset_id",
          "audience",
          "adaptation_tier",
          "detail",
          "materials",
          "opacity",
          "motion",
          "annotations",
          "pacing",
          "comfort_controls",
          "recommended_fallback",
          "warnings",
          "transparency",
          "source_asset_revision",
          "entity_mapping_status"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "policy_version": {
            "type": "string"
          },
          "asset_id": {
            "type": "string"
          },
          "audience": {
            "enum": [
              "patient",
              "family"
            ]
          },
          "adaptation_tier": {
            "enum": [
              "overview",
              "simplified",
              "standard",
              "clinical_detail"
            ]
          },
          "detail": {
            "type": "object"
          },
          "materials": {
            "type": "object"
          },
          "opacity": {
            "type": "object"
          },
          "motion": {
            "type": "object"
          },
          "annotations": {
            "type": "object"
          },
          "pacing": {
            "type": "object"
          },
          "comfort_controls": {
            "type": "object"
          },
          "recommended_fallback": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "transparency": {
            "type": "object"
          },
          "family_access": {
            "type": "object"
          },
          "source_asset_revision": {
            "$ref": "#/components/schemas/SourceAssetRevision"
          },
          "catalog_profile_revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "entity_mapping_revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "entity_mapping_status": {
            "enum": ["exact_revision_bound", "not_configured"]
          }
        }
      },
      "ReviewArtifactEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "artifact_role",
          "display_authorized",
          "review_gate",
          "source_asset_mutated",
          "recipe"
        ],
        "properties": {
          "schema_version": { "const": "1.0" },
          "artifact_role": { "const": "abstract_procedural_review_draft" },
          "display_authorized": { "const": false },
          "review_gate": {
            "const": "specialist_and_human_factors_review_required_before_patient_display"
          },
          "source_asset_mutated": { "const": false },
          "recipe": { "$ref": "#/components/schemas/Recipe" }
        }
      },
      "OrientationAssetCandidate": {
        "type": "object",
        "required": [
          "asset_id",
          "role",
          "clinical_review_status",
          "package_name",
          "package_bytes",
          "package_sha256",
          "package_integrity",
          "display_authorized",
          "review_gate",
          "co_load_with_source",
          "source_asset_remains_available"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "role": {
            "const": "orientation_only_candidate"
          },
          "clinical_review_status": {
            "type": "string"
          },
          "package_name": {
            "type": "string"
          },
          "package_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "package_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "package_integrity": {
            "enum": [
              "verified_against_manifest",
              "partially_verified_against_manifest",
              "observed_without_manifest_digest"
            ]
          },
          "display_authorized": {
            "const": false
          },
          "review_gate": {
            "const": "specialist_and_human_factors_review_required_before_patient_display"
          },
          "co_load_with_source": {
            "const": false
          },
          "source_asset_remains_available": {
            "const": true
          }
        }
      },
      "AdaptationResponseBase": {
        "type": "object",
        "required": [
          "request_id",
          "adaptation_id",
          "requested_mode",
          "source_asset",
          "presentation_preference",
          "recipe",
          "recipe_sha256"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "adaptation_id": {
            "type": "string"
          },
          "requested_mode": {
            "type": "string"
          },
          "source_asset": {
            "$ref": "#/components/schemas/SourceAsset"
          },
          "presentation_preference": {
            "$ref": "#/components/schemas/PresentationPreference"
          },
          "recipe": {
            "$ref": "#/components/schemas/Recipe"
          },
          "recipe_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "orientation_asset_candidate": {
            "$ref": "#/components/schemas/OrientationAssetCandidate"
          },
          "catalog_adaptation_profile": {
            "$ref": "#/components/schemas/CatalogAdaptationProfile"
          },
          "application_plan": {
            "$ref": "#/components/schemas/ApplicationPlan"
          },
          "latency_class": {
            "type": "string"
          }
        }
      },
      "CatalogAdaptationProfile": {
        "type": "object",
        "required": [
          "asset_id",
          "module",
          "content_categories",
          "graphic_content_tags",
          "presentation_intensity",
          "allowed_actions",
          "replacement_rules",
          "clinical_safeguards"
        ],
        "properties": {
          "asset_id": { "type": "string" },
          "module": { "type": "string" },
          "content_categories": { "type": "array", "items": { "type": "string" } },
          "graphic_content_tags": { "type": "array", "items": { "type": "string" } },
          "presentation_intensity": { "enum": ["minimal", "low", "moderate", "high"] },
          "allowed_actions": { "type": "object" },
          "replacement_rules": { "type": "object" },
          "clinical_safeguards": {
            "type": "object",
            "required": ["patient_display_authorized", "non_diagnostic", "anxiety_inference_allowed", "preserve_material_facts"],
            "properties": {
              "patient_display_authorized": { "const": false },
              "non_diagnostic": { "const": true },
              "anxiety_inference_allowed": { "const": false },
              "preserve_material_facts": { "const": true }
            }
          }
        }
      },
      "ChildIndexOperation": {
        "type": "object",
        "required": ["operation", "child_index_path", "debug_path"],
        "properties": {
          "operation": { "type": "string" },
          "child_index_path": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 }
          },
          "debug_path": { "type": "string" }
        }
      },
      "ApplicationPlan": {
        "type": "object",
        "required": [
          "schema_version",
          "mapping_status",
          "selector_kind",
          "source_package_sha256",
          "root_contract",
          "revision_mismatch_behavior",
          "semantic_group_coverage",
          "visibility_operations",
          "material_operations",
          "material_contract",
          "animation_operations",
          "animation_contract",
          "opacity_contract",
          "lod_contract",
          "presentation_ui_contract",
          "profile_action_contract",
          "content_warning_required",
          "progressive_disclosure_required",
          "unresolved_requested_changes",
          "fallback_if_unresolved",
          "restore_contract",
          "source_asset_unchanged",
          "source_medical_content_remains_available",
          "medical_content_preservation_status",
          "patient_display_authorized",
          "operation_counts"
        ],
        "properties": {
          "schema_version": { "const": "1.0" },
          "mapping_status": { "const": "exact_revision_bound" },
          "selector_kind": { "const": "child_index_path" },
          "source_package_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "root_contract": { "type": "string" },
          "revision_mismatch_behavior": { "type": "string" },
          "semantic_group_coverage": {
            "type": "object",
            "required": [
              "present_groups",
              "requested_hidden_groups_present",
              "requested_hidden_groups_not_present",
              "absent_group_behavior"
            ],
            "properties": {
              "present_groups": { "type": "array", "items": { "type": "string" } },
              "requested_hidden_groups_present": { "type": "array", "items": { "type": "string" } },
              "requested_hidden_groups_not_present": { "type": "array", "items": { "type": "string" } },
              "absent_group_behavior": { "const": "not_applicable_no_fallback" }
            }
          },
          "visibility_operations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChildIndexOperation" }
          },
          "protected_primary_matches_not_hidden": { "type": "integer", "minimum": 0 },
          "profile_blocked_visibility_matches": { "type": "integer", "minimum": 0 },
          "material_operations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChildIndexOperation" }
          },
          "material_contract": {
            "type": "object",
            "required": [
              "status",
              "clinical_detail_behavior",
              "protected_semantic_groups",
              "protected_entity_count",
              "mapped_labels_and_primary_pathology_remain_unmodified",
              "source_legend_and_unmodified_asset_remain_available"
            ],
            "properties": {
              "status": { "const": "display_blocked_developer_preview_only" },
              "clinical_detail_behavior": { "const": "preserve_source_materials" },
              "protected_semantic_groups": { "type": "array", "items": { "type": "string" } },
              "protected_entity_count": { "type": "integer", "minimum": 0 },
              "mapped_labels_and_primary_pathology_remain_unmodified": { "const": true },
              "source_legend_and_unmodified_asset_remain_available": { "const": true }
            }
          },
          "animation_operations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChildIndexOperation" }
          },
          "animation_contract": {
            "type": "object",
            "required": ["static_pose_strategy", "reviewed_representative_frame_available", "invented_animation_allowed"],
            "properties": {
              "static_pose_strategy": { "enum": ["initial_authored_pose", "not_requested"] },
              "reviewed_representative_frame_available": { "const": false },
              "invented_animation_allowed": { "const": false }
            }
          },
          "opacity_contract": {
            "type": "object",
            "required": ["strategy", "requested_values", "opacity_operations", "reason"],
            "properties": {
              "strategy": { "const": "discrete_visibility_only_no_runtime_transparency" },
              "requested_values": { "type": "object" },
              "opacity_operations": { "type": "array", "maxItems": 0 },
              "reason": { "type": "string" }
            }
          },
          "lod_contract": {
            "type": "object",
            "required": ["requested_bias", "runtime_lod_variant_available", "applied", "behavior"],
            "properties": {
              "requested_bias": { "type": "integer", "minimum": 0 },
              "runtime_lod_variant_available": { "const": false },
              "applied": { "const": false },
              "behavior": { "const": "preserve_source_geometry_and_profile_on_device" }
            }
          },
          "presentation_ui_contract": {
            "type": "object",
            "required": [
              "owner",
              "annotations",
              "pacing",
              "comfort_controls",
              "authored_geometry_labels_automatically_hidden",
              "reason"
            ],
            "properties": {
              "owner": { "const": "visionOS_application" },
              "annotations": { "type": "object" },
              "pacing": { "type": "object" },
              "comfort_controls": { "type": "object" },
              "authored_geometry_labels_automatically_hidden": { "const": false },
              "reason": { "type": "string" }
            }
          },
          "profile_action_contract": { "type": "object" },
          "content_warning_required": { "type": "boolean" },
          "progressive_disclosure_required": { "type": "boolean" },
          "unresolved_requested_changes": { "type": "boolean" },
          "fallback_if_unresolved": { "type": "string" },
          "restore_contract": { "type": "object" },
          "source_asset_unchanged": { "const": true },
          "source_medical_content_remains_available": { "const": true },
          "medical_content_preservation_status": {
            "const": "requires_external_clinical_and_human_factors_review"
          },
          "patient_display_authorized": { "const": false },
          "operation_counts": {
            "type": "object",
            "required": ["visibility", "materials", "animations"],
            "properties": {
              "visibility": { "type": "integer", "minimum": 0 },
              "materials": { "type": "integer", "minimum": 0 },
              "animations": { "type": "integer", "minimum": 0 }
            }
          }
        }
      },
      "ApplicationContract": {
        "type": "object",
        "required": [
          "engine",
          "operation",
          "mutates_source_asset",
          "fallback_if_semantic_layers_missing",
          "developer_preview_authorized",
          "developer_runtime_application_authorized",
          "semantic_mapping_status",
          "fallback_required",
          "source_asset_manifest_approved",
          "patient_display_authorized",
          "patient_display_review_required",
          "required_manifest_status_for_patient_display",
          "required_adaptive_policy_approval",
          "authorization_notice"
        ],
        "properties": {
          "engine": {
            "const": "RealityKit"
          },
          "operation": {
            "const": "apply_recipe_at_runtime"
          },
          "mutates_source_asset": {
            "const": false
          },
          "fallback_if_semantic_layers_missing": {
            "type": "string"
          },
          "developer_preview_authorized": {
            "const": true
          },
          "developer_runtime_application_authorized": {
            "type": "boolean",
            "description": "True only when exact package-revision-bound profiles and entity bindings were loaded."
          },
          "semantic_mapping_status": {
            "enum": ["exact_revision_bound", "not_configured"]
          },
          "fallback_required": {
            "type": "boolean"
          },
          "source_asset_manifest_approved": {
            "type": "boolean"
          },
          "patient_display_authorized": {
            "const": false
          },
          "patient_display_review_required": {
            "const": true
          },
          "required_manifest_status_for_patient_display": {
            "const": "APPROVED_FOR_PATIENT_EDUCATION"
          },
          "required_adaptive_policy_approval": {
            "const": "presentation-preference-v2"
          },
          "authorization_notice": {
            "type": "string"
          }
        }
      },
      "EditResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AdaptationResponseBase"
          },
          {
            "type": "object",
            "properties": {
              "resolved_mode": {
                "const": "edit"
              },
              "status": {
                "const": "completed"
              },
              "application_contract": {
                "$ref": "#/components/schemas/ApplicationContract"
              }
            },
            "required": [
              "resolved_mode",
              "status",
              "application_contract"
            ]
          }
        ]
      },
      "GenerateResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AdaptationResponseBase"
          },
          {
            "type": "object",
            "properties": {
              "resolved_mode": {
                "const": "generate"
              },
              "status": {
                "const": "accepted"
              },
              "generation_contract": {
                "$ref": "#/components/schemas/GenerationJob"
              }
            },
            "required": [
              "resolved_mode",
              "status",
              "generation_contract"
            ]
          }
        ]
      },
      "GenerationJob": {
        "type": "object",
        "required": [
          "job_id",
          "status",
          "generator",
          "generator_kind",
          "model_provider",
          "source_asset_mutated",
          "display_authorized",
          "review_gate",
          "artifact_role",
          "limitations"
        ],
        "properties": {
          "job_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "status": {
            "enum": [
              "queued",
              "awaiting_clinician_review",
              "failed"
            ]
          },
          "generator": {
            "const": "local_procedural_comfort_template_v1"
          },
          "generator_kind": {
            "const": "deterministic_non_ai_template"
          },
          "model_provider": {
            "type": "null"
          },
          "source_asset_mutated": {
            "const": false
          },
          "display_authorized": {
            "const": false
          },
          "review_gate": {
            "const": "clinician_review_required_before_display"
          },
          "artifact_role": {
            "const": "abstract_procedural_review_draft"
          },
          "orientation_asset_candidate": {
            "$ref": "#/components/schemas/OrientationAssetCandidate"
          },
          "draft_artifacts": {
            "type": "object"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "request_id",
          "error"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "field": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
