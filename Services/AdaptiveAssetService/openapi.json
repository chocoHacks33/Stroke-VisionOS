          "developer_preview_authorized",
          "source_asset_manifest_approved",
          "patient_display_authorized",
          "patient_display_review_required",
          "required_manifest_status_for_patient_display",
          "required_adaptive_policy_approval",
          "authorization_notice"
        ],
        "properties": {
          "engine": {
            "const": "RealityKit"
          },
          "operation": {
            "const": "apply_recipe_at_runtime"
          },
          "mutates_source_asset": {
            "const": false
          },
          "fallback_if_semantic_layers_missing": {
            "type": "string"
          },
          "developer_preview_authorized": {
            "const": true
          },
          "source_asset_manifest_approved": {
            "type": "boolean"
          },
          "patient_display_authorized": {
            "const": false
          },
          "patient_display_review_required": {
            "const": true
          },
          "required_manifest_status_for_patient_display": {
            "const": "APPROVED_FOR_PATIENT_EDUCATION"
          },
          "required_adaptive_policy_approval": {
            "const": "presentation-preference-v1"
          },
          "authorization_notice": {
            "type": "string"
          }
        }
      },
      "EditResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AdaptationResponseBase"
          },
          {
            "type": "object",
            "properties": {
              "resolved_mode": {
                "const": "edit"
              },
              "status": {
                "const": "completed"
              },
              "application_contract": {
                "$ref": "#/components/schemas/ApplicationContract"
              }
            },
            "required": [
              "resolved_mode",
              "status",
              "application_contract"
            ]
          }
        ]
      },
      "GenerateResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AdaptationResponseBase"
          },
          {
            "type": "object",
            "properties": {
              "resolved_mode": {
                "const": "generate"
              },
              "status": {
                "const": "accepted"
              },
              "generation_contract": {
                "$ref": "#/components/schemas/GenerationJob"
              }
            },
            "required": [
              "resolved_mode",
              "status",
              "generation_contract"
            ]
          }
        ]
      },
      "GenerationJob": {
        "type": "object",
        "required": [
          "job_id",
          "status",
          "generator",
          "generator_kind",
          "model_provider",
          "source_asset_mutated",
          "display_authorized",
          "review_gate",
          "artifact_role",
          "limitations"
        ],
        "properties": {
          "job_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "status": {
            "enum": [
              "queued",
              "awaiting_clinician_review",
              "failed"
            ]
          },
          "generator": {
            "const": "local_procedural_comfort_template_v1"
          },
          "generator_kind": {
            "const": "deterministic_non_ai_template"
          },
          "model_provider": {
            "type": "null"
          },
          "source_asset_mutated": {
            "const": false
          },
          "display_authorized": {
            "const": false
          },
          "review_gate": {
            "const": "clinician_review_required_before_display"
          },
          "artifact_role": {
            "const": "abstract_procedural_review_draft"
          },
          "orientation_asset_candidate": {
            "$ref": "#/components/schemas/OrientationAssetCandidate"
          },
          "draft_artifacts": {
            "type": "object"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "request_id",
          "error"
